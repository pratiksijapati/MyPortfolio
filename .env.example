# Copy to .env to use locally. All VITE_* values end up in the public JavaScript bundle,
# so only put public values here — never a secret API key.

# Optional. A form endpoint that accepts a JSON POST, e.g. https://formspree.io/f/xxxxxxx
# Without it, the contact form opens the visitor's email app with the message filled in.
VITE_CONTACT_ENDPOINT=
